# --- PostgreSQL / pgvector ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ai_tutor
PG_USER=ai_tutor_app
PG_PASSWORD=change_me
PG_COLLECTION=ai_tutor_documents

# --- Embedding LOCAL (sentence-transformers, không tốn quota API) ---
# BAAI/bge-m3: đa ngôn ngữ, hỗ trợ tiếng Việt tốt, phù hợp cho RAG.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
# Nếu đổi EMBEDDING_MODEL sau khi đã index dữ liệu, PHẢI đổi PG_COLLECTION
# sang tên mới và index lại toàn bộ tài liệu (số chiều vector khác nhau giữa
# các model -> không thể dùng chung 1 collection cũ).

# --- Chunking & OCR ---
CHUNKING_STRATEGY=fixed
ENABLE_OCR=true

# --- Observability: LangSmith tracing (tuỳ chọn) ---
# Bật để xem chi tiết từng bước agent chạy (tool nào được gọi, prompt/response
# đầy đủ, latency từng bước) trên dashboard https://smith.langchain.com —
# không cần sửa code, LangChain/LangGraph tự đọc các biến này.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=ai-tutor

# --- Google Gemini (chỉ dùng cho LLM/agent, KHÔNG dùng cho embedding) ---
GOOGLE_API_KEY=your_google_api_key_here
# Kiểm tra tên model hiện hành tại https://ai.google.dev/gemini-api/docs/models
# trước khi deploy — tên model Gemini thay đổi theo thời gian.
# gemini-2.0-flash đã bị khai tử (03/2026); free tier hiện chỉ còn dòng Flash
# (Pro không còn miễn phí từ 04/2026).
LLM_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.3

# --- Cohere (rerank) ---
COHERE_API_KEY=your_cohere_api_key_here
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# --- Indexing ---
EMBEDDING_BATCH_SIZE=50

# --- Logging ---
LOG_LEVEL=INFO
